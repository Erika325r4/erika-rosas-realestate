# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local — it's already gitignored.

# Public site URL, used for canonical links, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.erikarosasrealestate.com

# --- Forms (see docs/FORM-INTEGRATION.md) ---
# Pick ONE delivery method and fill in its variables. Leave the others blank.

# Option A: transactional email (e.g. Resend, Postmark, SendGrid)
# EMAIL_PROVIDER_API_KEY=
# LEAD_NOTIFICATION_EMAIL=

# Option B: CRM webhook
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=

# --- Rate limiting (see docs/FORM-INTEGRATION.md) ---
# Required only if you replace the in-memory rate limiter with a durable store.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- IDX / MLS (see docs/IDX-INTEGRATION.md) ---
# IDX_PROVIDER=
# IDX_API_KEY=
# IDX_ACCOUNT_ID=

# --- Analytics (see docs/DEPLOYMENT.md) ---
# NEXT_PUBLIC_ANALYTICS_ID=
